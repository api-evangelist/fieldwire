              "item": [
                {
                  "name": "Get AWS POST Token For Upload",
                  "id": "375ed2a5-924a-4caa-9406-3549f40daa5e",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"filename\": \"<string>\",\n  \"content_type\": \"<string>\",\n  \"size\": \"<long>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/projects/:project_id/aws_post_tokens",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "projects",
                        ":project_id",
                        "aws_post_tokens"
                      ],
                      "variable": [
                        {
                          "id": "7e15c4ff-6dd0-4a92-9f19-08db2593bf22",
                          "key": "project_id",
                          "value": "<long>",
                          "description": "(Required) "
                        }
                      ]
                    },
                    "description": "Request a one-day signed AWS POST token that the client uses to upload\nthe binary directly to Amazon S3. The token contains the post URL,\npolicy, and form fields required for the S3 `POST object` operation;\nclients then add a `file` form field and POST to AWS directly.\n"
                  },
