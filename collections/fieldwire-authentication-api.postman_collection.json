      "item": [
        {
          "id": "98695414-2cda-45fa-9c27-cf296250cd4e",
          "name": "Exchange API Key For Access Token",
          "request": {
            "name": "Exchange API Key For Access Token",
            "description": {
              "content": "Exchange the long-lived refresh token (API key) generated from the\nFieldwire account settings for a short-lived JWT access token. The JWT\nprotects all subsequent calls and expires in minutes to hours.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api_keys",
                "jwt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_token\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6af2e99d-fa4e-4cc2-8703-238ee481fe0b",
              "name": "Access token issued.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api_keys",
                    "jwt"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"api_token\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"expires_at\": \"1973-10-17T12:27:39.196Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
