  "item": [
    {
      "id": "49145fa4-0bf7-4ad8-a430-0708987cb1f3",
      "name": "S3 Tokens",
      "description": {
        "content": "Short-lived signed AWS POST tokens for direct-to-S3 uploads.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "63f533ce-c9ed-43bb-b390-42ccf2b69de9",
          "name": "Get AWS POST Token For Upload",
          "request": {
            "name": "Get AWS POST Token For Upload",
            "description": {
              "content": "Request a one-day signed AWS POST token that the client uses to upload\nthe binary directly to Amazon S3. The token contains the post URL,\npolicy, and form fields required for the S3 `POST object` operation;\nclients then add a `file` form field and POST to AWS directly.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "aws_post_tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "project_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"<string>\",\n  \"content_type\": \"<string>\",\n  \"size\": \"<long>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ad65c77e-af07-4213-8f93-1ff8cdd05c25",
              "name": "Signed POST token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "projects",
                    ":project_id",
                    "aws_post_tokens"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<long>",
                      "key": "project_id",
                      "description": "(Required) "
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"filename\": \"<string>\",\n  \"content_type\": \"image/jpeg\",\n  \"size\": \"<long>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 3574,\n  \"post_address\": \"https://TuipFBMYWwpPBwuTHBLodZoyj.hfoKnnV1Hz7m+h-IQ2MhBSxnklDyFYL4jFT02ln3nJ\",\n  \"fields\": {\n    \"key_0\": \"string\"\n  },\n  \"expires_at\": \"2004-08-05T18:55:24.666Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://client-api.super.fieldwire.com",
      "key": "baseUrl"
